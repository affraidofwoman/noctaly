# ─────────────────────────────────────────────────────────────
#  BOT DISCORD — copie ce fichier en « .env » puis remplis-le.
#  Ne partage JAMAIS le fichier .env (il contient des secrets).
# ─────────────────────────────────────────────────────────────

# ── Discord (obligatoire) ── https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Nécessaire uniquement pour le dashboard web (connexion avec Discord)
DISCORD_CLIENT_SECRET=

# IDs Discord des propriétaires du bot (séparés par des virgules).
# Ils ont tous les droits partout et gèrent les enseignes (/custom) et la whitelist owner.
BOT_OWNER_IDS=

# Nom affiché quand un serveur n'a pas d'enseigne streamer
BOT_BRAND_NAME=Twitch Community

# En développement : ID d'un serveur de test pour enregistrer les commandes instantanément.
# Laisse vide en production (commandes globales, propagation de quelques minutes).
DEV_GUILD_ID=
# Enregistre automatiquement les commandes au démarrage si elles ont changé
AUTO_DEPLOY_COMMANDS=true

# ── Stockage ──
DATABASE_PATH=./data/bot.sqlite
BACKUP_DIR=./data/backups
# debug | info | warn | error
LOG_LEVEL=info
DEFAULT_TIMEZONE=Europe/Paris

# ── Twitch (annonces de live) ── https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Fréquence de vérification des lives, en secondes (30 minimum)
TWITCH_POLL_SECONDS=60
# Optionnel — raids, follows et abonnements (EventSub) : jeton UTILISATEUR du streamer
# avec les scopes moderator:read:followers et channel:read:subscriptions.
TWITCH_USER_TOKEN=
TWITCH_REFRESH_TOKEN=

# ── Musique ──
# Chemins facultatifs si FFmpeg / yt-dlp ne sont pas trouvés automatiquement
FFMPEG_PATH=
YTDLP_PATH=
# Optionnel : liens Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optionnel : cookie YouTube si YouTube bloque la lecture sur ton hébergeur
YOUTUBE_COOKIE=

# ── Dashboard web ──
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3000
# Adresse publique du dashboard (à ajouter dans OAuth2 → Redirects : <URL>/callback)
DASHBOARD_URL=http://localhost:3000
# Chaîne aléatoire d'au moins 32 caractères (ex : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
DASHBOARD_SESSION_SECRET=
